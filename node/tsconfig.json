{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "rootDir": "ts",
    "outDir": "lib",
    "declaration": true,
    "stripInternal": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "ts/core.ts",
    "ts/read.ts",
    "ts/index.ts"
  ]
}
